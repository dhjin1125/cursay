{
  "name": "codex-voice-control",
  "version": "0.1.0",
  "private": true,
  "description": "Cursay voice input for any macOS text field.",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "pnpm build:native && pnpm build:electron && concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on tcp:4174 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:4174 electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "pnpm typecheck && pnpm test && pnpm build:icon && pnpm build:native && vite build && pnpm build:electron",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --external:ws --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "build:native": "bash scripts/build-native-helper.sh",
    "build:icon": "bash scripts/build-icon.sh",
    "verify:signing": "bash scripts/verify-release-signing.sh",
    "diagnose:dictation": "node scripts/probe-dictation-connection.mjs",
    "diagnose:dictation:chromium": "electron scripts/probe-dictation-chromium.cjs",
    "diagnose:dictation:segment": "electron scripts/probe-dictation-chromium.cjs --delivery-mode=segment",
    "diagnose:dictation:delta": "electron scripts/probe-dictation-chromium.cjs --delivery-mode=delta",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:mac": "pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir && bash scripts/adhoc-sign-release.sh"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.3",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "local.minkyu.CodexVoiceControl",
    "productName": "Cursay",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/tray-template*.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/build/Codex Voice Control.app",
        "to": "native/Codex Voice Control.app"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        "dir"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Cursay uses the microphone only while voice input is explicitly enabled.",
        "NSAppleEventsUsageDescription": "Cursay may target an allowlisted application when you configure a voice command."
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "author": {
    "name": "노드오프",
    "email": "jin@nodeoff.kr",
    "url": "https://nodeoff.kr"
  }
}
